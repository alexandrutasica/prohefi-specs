     "url": "^https://reactjobs\\.io(?=[/?#]|$).*?/react-jobs/[^/]+/\\d+-[^/?#]+",
     "roots": {
      "sel": "main",
      "has": [
       "h1",
       ".prose"
      ]
     },
     "identity": [
      {
       "from": "url",
       "pattern": "/react-jobs/[^/]+/(\\d+)-"
      },
      {
       "jsonld": "url",
       "pattern": "/react-jobs/[^/]+/(\\d+)-"
      }
     ],
     "title": [
      "h1",
      {
       "jsonld": "title"
      }
     ],
     "company": [
      {
       "rows": {
        "rows": "aside dt",
        "match": "^company$",
        "next": true
       }
      },
      {
       "jsonld": "hiringOrganization.name"
      }
     ],
     "location": {
      "rows": {
       "rows": "aside dt",
       "match": "^location$",
       "next": true
      }
     },
     "labels": [
      [
       {
        "rows": {
         "rows": "aside dt",
         "match": "^employment type$",
         "next": true
        }
       },
       {
        "jsonld": "employmentType"
       }
      ]
     ],
     "salary": [
      {
       "rows": {
        "rows": "aside dt",
        "match": "^salary$",
        "next": true
       }
      },
      {
       "jsonld": "baseSalary",
       "then": "ldSalary"
      }
     ],
     "pay": "as-is",
     "description": ".prose",
     "mount": [
      {
       "sel": "h1",
       "closest": "section",
       "next": true
      },
      ".prose"
     ]
    }
   ]
  },
